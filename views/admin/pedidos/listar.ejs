
<%- include('../../partials/head', {
    tituloPagina: 'Pedidos | Pé na Areia'
}) %>

<%- include('../../partials/navbar', {
    paginaAtiva: 'pedidos'
}) %>

    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-1">Gerenciamento de Pedidos</h1>
                <p class="text-muted mb-0">Consulte e acompanhe os pedidos realizados.</p>
            </div>
            <a href="/admin/pedidos/cadastrar" class="btn btn-primary">
    + Novo pedido
</a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">

                
<form action="/admin/pedidos" method="GET" class="mb-3">
    <div class="input-group">
        <input
            type="text"
            name="busca"
            class="form-control"
            placeholder="Buscar por número do pedido ou nome do cliente..."
            value="<%= busca || '' %>"
        >

        <button type="submit" class="btn btn-primary">
            Pesquisar
        </button>

        <a href="/admin/pedidos" class="btn btn-outline-secondary">
            Limpar
        </a>
    </div>
</form>


                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>Número</th>
                                <th>Cliente</th>
                                <th>Data</th>
                                <th>Valor total</th>
                                <th>Status</th>
                                <th>Pagamento</th>
                                <th>Ações</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% if (pedidos.length === 0) { %>

                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        Nenhum pedido encontrado.
                                    </td>
                                </tr>

                            <% } else { %>

                                <% pedidos.forEach(pedido => { %>

                                    <tr>
                                        <td>
                                            <strong><%= pedido.numero %></strong>
                                        </td>

                                        <td><%= pedido.nomeCliente %></td>

                                        <td>
                                            <%= new Date(pedido.dataPedido).toLocaleDateString('pt-BR') %>
                                        </td>

                                        <td>
                                            <%= Number(pedido.valorTotal).toLocaleString('pt-BR', {
                                                style: 'currency',
                                                currency: 'BRL'
                                            }) %>
                                        </td>

                                        <td>
                                            <span class="badge bg-primary">
                                                <%= pedido.status %>
                                            </span>
                                        </td>

                                        <td>
                                            <span class="badge bg-secondary">
                                                <%= pedido.statusPagamento %>
                                            </span>
                                        </td>

                                        <td>
                                            <a
                                                href="/admin/pedidos/visualizar/<%= pedido._id %>"
                                                class="btn btn-sm btn-outline-primary">
                                                Visualizar
                                            </a>
                                        </td>
                                    </tr>

                                <% }); %>

                            <% } %>

                        </tbody>

                    </table>
                </div>

            </div>
        </div>

        <div class="mt-3">
            <a href="/admin" class="btn btn-outline-secondary">
                Voltar ao painel
            </a>
        </div>

    </div>

<%- include('../../partials/footer') %>
