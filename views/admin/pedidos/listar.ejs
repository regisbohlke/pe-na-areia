
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pedidos - Pé na Areia</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-1">Gerenciamento de Pedidos</h1>
                <p class="text-muted mb-0">Consulte e acompanhe os pedidos realizados.</p>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">

                <form action="/admin/pedidos" method="GET" class="row g-2 mb-4">
                    <div class="col-md-10">
                        <input
                            type="text"
                            name="busca"
                            class="form-control"
                            placeholder="Buscar por número do pedido ou nome do cliente..."
                            value="<%= busca %>"
                        >
                    </div>

                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">
                            Buscar
                        </button>
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Número</th>
                                <th>Cliente</th>
                                <th>Data</th>
                                <th>Valor total</th>
                                <th>Status</th>
                                <th>Pagamento</th>
                                <th>Ações</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if (pedidos.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        Nenhum pedido encontrado.
                                    </td>
                                </tr>
                            <% } %>

                            <% if (pedidos.length === 0) { %>
    <tr>
        <td colspan="7" class="text-center text-muted py-4">
            Nenhum pedido encontrado.
        </td>
    </tr>
<% } else { %>

    <% pedidos.forEach(pedido => { %>
        <tr>
            <td><strong><%= pedido.numero %></strong></td>
            <td><%= pedido.nomeCliente %></td>

            <td>
                <%= new Date(pedido.dataPedido).toLocaleDateString('pt-BR') %>
            </td>

            <td>
                R$ <%= Number(pedido.valorTotal).toFixed(2).replace('.', ',') %>
            </td>

            <td>
                <span class="badge bg-primary">
                    <%= pedido.status %>
                </span>
            </td>

            <td>
                <span class="badge bg-secondary">
                    <%= pedido.statusPagamento %>
                </span>
            </td>

            <td>
                <a
                    href="/admin/pedidos/visualizar/<%= pedido._id %>"
                    class="btn btn-sm btn-outline-primary">
                    Visualizar
                </a>
            </td>
        </tr>
    <% }); %>

<% } %>