
<%- include('../../partials/head', {
    tituloPagina: 'Novo Pedido | Pé na Areia'
}) %>

<%- include('../../partials/navbar', {
    paginaAtiva: 'pedidos'
}) %>

    <div class="container py-5">

        <div class="mb-4">
            <h1 class="h3 mb-1">Cadastrar Pedido</h1>
            <p class="text-muted mb-0">Preencha os dados do cliente e adicione os produtos.</p>
        </div>

        <form action="/admin/pedidos/cadastrar" method="POST">

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3">Dados do cliente</h2>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="nomeCliente" class="form-label">Nome do cliente</label>
                            <input
                                type="text"
                                id="nomeCliente"
                                name="nomeCliente"
                                class="form-control"
                                required
                            >
                        </div>

                        <div class="col-md-6">
                            <label for="whatsapp" class="form-label">WhatsApp</label>
                            <input
                                type="text"
                                id="whatsapp"
                                name="whatsapp"
                                class="form-control"
                                placeholder="(00) 00000-0000"
                                required
                            >
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h5 mb-0">Produtos do pedido</h2>

                        <button type="button" id="adicionarProduto" class="btn btn-outline-primary btn-sm">
                            + Adicionar produto
                        </button>
                    </div>

                    <div id="listaProdutos">

                        <div class="row g-2 align-items-end produto-item mb-3">

                            <div class="col-md-7">
                                <label class="form-label">Produto</label>

                                <select name="produtos" class="form-select produto-select" required>
                                    <option value="">Selecione um produto</option>

                                    <% produtos.forEach(produto => { %>
                                        <option
                                            value="<%= produto._id %>"
                                            data-preco="<%= produto.preco %>"
                                        >
                                            <%= produto.nome %> -
                                            <%= Number(produto.preco).toLocaleString('pt-BR', {
                                                style: 'currency',
                                                currency: 'BRL'
                                            }) %>
                                        </option>
                                    <% }) %>
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Quantidade</label>
                                <input
                                    type="number"
                                    name="quantidades"
                                    class="form-control quantidade"
                                    value="1"
                                    min="1"
                                    required
                                >
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Subtotal</label>
                                <input type="text" class="form-control subtotal" value="R$ 0,00" readonly>
                            </div>

                            <div class="col-md-1">
                                <button type="button" class="btn btn-outline-danger remover-produto w-100" disabled>
                                    X
                                </button>
                            </div>

                        </div>

                    </div>

                    <hr>

                    <div class="d-flex justify-content-end align-items-center gap-3">
                        <strong class="fs-5">Total do pedido:</strong>
                        <strong class="fs-4 text-primary" id="valorTotal">R$ 0,00</strong>
                    </div>

                </div>
            </div>

            <div class="d-flex justify-content-between">
                <a href="/admin/pedidos" class="btn btn-outline-secondary">
                    Cancelar
                </a>

                <button type="submit" class="btn btn-primary">
                    Cadastrar pedido
                </button>
            </div>

        </form>

    </div>

    <script>
        const listaProdutos = document.getElementById('listaProdutos');
        const botaoAdicionar = document.getElementById('adicionarProduto');

        function formatarMoeda(valor) {
            return Number(valor).toLocaleString('pt-BR', {
                style: 'currency',
                currency: 'BRL'
            });
        }

        function calcularTotal() {
            let total = 0;

            document.querySelectorAll('.produto-item').forEach(item => {
                const select = item.querySelector('.produto-select');
                const quantidade = item.querySelector('.quantidade');
                const subtotalCampo = item.querySelector('.subtotal');

                const preco = Number(
                    select.selectedOptions[0]?.dataset.preco || 0
                );

                const qtd = Number(quantidade.value) || 0;
                const subtotal = preco * qtd;

                subtotalCampo.value = formatarMoeda(subtotal);

                total += subtotal;
            });

            document.getElementById('valorTotal').textContent =
                formatarMoeda(total);
        }

        function atualizarBotoesRemover() {
            const itens = document.querySelectorAll('.produto-item');

            itens.forEach(item => {
                item.querySelector('.remover-produto').disabled =
                    itens.length === 1;
            });
        }

        function atualizarOpcoes() {
            const selects = document.querySelectorAll('.produto-select');
            const selecionados = Array.from(selects)
                .map(select => select.value)
                .filter(Boolean);

            selects.forEach(select => {
                Array.from(select.options).forEach(option => {
                    if (!option.value) return;

                    option.disabled =
                        selecionados.includes(option.value) &&
                        select.value !== option.value;
                });
            });
        }

        function prepararLinha(item) {
            item.querySelector('.produto-select').addEventListener('change', () => {
                calcularTotal();
                atualizarOpcoes();
            });

            item.querySelector('.quantidade').addEventListener('input', calcularTotal);

            item.querySelector('.remover-produto').addEventListener('click', () => {
                item.remove();
                atualizarBotoesRemover();
                atualizarOpcoes();
                calcularTotal();
            });
        }

        prepararLinha(document.querySelector('.produto-item'));

        botaoAdicionar.addEventListener('click', () => {
            const original = document.querySelector('.produto-item');
            const novaLinha = original.cloneNode(true);

            novaLinha.querySelector('.produto-select').value = '';
            novaLinha.querySelector('.quantidade').value = 1;
            novaLinha.querySelector('.subtotal').value = formatarMoeda(0);

            listaProdutos.appendChild(novaLinha);

            prepararLinha(novaLinha);
            atualizarBotoesRemover();
            atualizarOpcoes();
            calcularTotal();
        });

    </script>

<%- include('../../partials/footer') %>
