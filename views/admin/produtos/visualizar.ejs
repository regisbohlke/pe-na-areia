<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalhes do Produto | Pé na Areia</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Pé na Areia</a>
            <span class="navbar-text text-white">Administração</span>
        </div>
    </nav>

    <main class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0">Detalhes do Produto</h1>
            <a href="/admin/produtos" class="btn btn-secondary">Voltar</a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <% if (produto.imagem) { %>
                    <div class="mb-3">
                        <img src="<%= produto.imagem %>" alt="<%= produto.nome %>" class="img-fluid rounded" style="max-height: 250px;">
                    </div>
                <% } %>

                <h2 class="h4"><%= produto.nome %></h2>
                <p class="mb-2">
                    <strong>Categoria:</strong>
                    <span class="badge bg-secondary">
                        <%= produto.categoria ? produto.categoria.nome : 'Sem categoria' %>
                    </span>
                </p>
                <p class="mb-2">
                    <strong>Preço:</strong> R$ <%= produto.preco.toFixed(2).replace('.', ',') %>
                </p>
                <p class="mb-2">
                    <strong>Status:</strong>
                    <% if (produto.disponivel) { %>
                        <span class="badge bg-success">Disponível</span>
                    <% } else { %>
                        <span class="badge bg-danger">Indisponível</span>
                    <% } %>
                </p>
                <p class="mb-4">
                    <strong>Descrição:</strong><br>
                    <%= produto.descricao || 'Nenhuma descrição informada.' %>
                </p>

                <div class="d-flex gap-2">
                    <a href="/admin/produtos/editar/<%= produto._id %>" class="btn btn-warning">Editar Produto</a>
                    <form action="/admin/produtos/excluir/<%= produto._id %>" method="POST" class="d-inline" onsubmit="return confirm('Tem certeza que deseja excluir este produto?');">
                        <button type="submit" class="btn btn-danger">Excluir Produto</button>
                    </form>
                </div>
            </div>
        </div>
    </main>

</body>
</html>