<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produtos | Pé na Areia</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Pé na Areia</a>
            <div class="d-flex gap-3">
                <a class="nav-link text-white" href="/admin/categorias">Categorias</a>
                <a class="nav-link text-white fw-bold" href="/admin/produtos">Produtos</a>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-1">Produtos</h1>
                <p class="text-muted mb-0">Gerencie os produtos do cardápio</p>
            </div>
            <a href="/admin/produtos/novo" class="btn btn-primary">+ Novo Produto</a>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <form action="/admin/produtos" method="GET" class="row g-2">
                    <div class="col-md-10">
                        <input
                            type="text"
                            name="busca"
                            class="form-control"
                            placeholder="Pesquisar produto por nome..."
                            value="<%= busca %>"
                        >
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-outline-primary">Pesquisar</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Nome</th>
                                <th>Categoria</th>
                                <th>Preço</th>
                                <th>Status</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (produtos.length === 0) { %>
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        Nenhum produto encontrado.
                                    </td>
                                </tr>
                            <% } else { %>
                                <% produtos.forEach(produto => { %>
                                    <tr>
                                        <td class="fw-semibold"><%= produto.nome %></td>
                                        <td>
                                            <span class="badge bg-secondary">
                                                <%= produto.categoria ? produto.categoria.nome : 'Sem categoria' %>
                                            </span>
                                        </td>
                                        <td>R$ <%= produto.preco.toFixed(2).replace('.', ',') %></td>
                                        <td>
                                            <% if (produto.disponivel) { %>
                                                <span class="badge bg-success">Disponível</span>
                                            <% } else { %>
                                                <span class="badge bg-danger">Indisponível</span>
                                            <% } %>
                                        </td>
                                        <td class="text-end">
                                            <a href="/admin/produtos/visualizar/<%= produto._id %>" class="btn btn-sm btn-outline-info">Ver</a>
                                            <a href="/admin/produtos/editar/<%= produto._id %>" class="btn btn-sm btn-outline-warning">Editar</a>
                                            <form action="/admin/produtos/excluir/<%= produto._id %>" method="POST" class="d-inline" onsubmit="return confirm('Tem certeza que deseja excluir este produto?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

</body>
</html>