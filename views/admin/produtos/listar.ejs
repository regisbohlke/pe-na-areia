<%- include('../../partials/head', {
    tituloPagina: 'Produtos | Pé na Areia'
}) %>

<%- include('../../partials/navbar', {
    paginaAtiva: 'produtos'
}) %>

    <main class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-1">Produtos</h1>
                <p class="text-muted mb-0">Gerencie os produtos do cardápio</p>
            </div>
            <a href="/admin/produtos/novo" class="btn btn-primary">+ Novo Produto</a>
        </div>

        
<form action="/admin/produtos" method="GET" class="mb-3">
    <div class="input-group">
        <input
            type="text"
            name="busca"
            class="form-control"
            placeholder="Pesquisar produto pelo nome..."
            value="<%= busca || '' %>"
        >

        <button type="submit" class="btn btn-primary">
            Pesquisar
        </button>

        <a href="/admin/produtos" class="btn btn-outline-secondary">
            Limpar
        </a>
    </div>
</form>


        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Nome</th>
                                <th>Categoria</th>
                                <th>Preço</th>
                                <th>Status</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (produtos.length === 0) { %>
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        Nenhum produto encontrado.
                                    </td>
                                </tr>
                            <% } else { %>
                                <% produtos.forEach(produto => { %>
                                    <tr>
                                        <td class="fw-semibold"><%= produto.nome %></td>
                                        <td>
                                            <span class="badge bg-secondary">
                                                <%= produto.categoria ? produto.categoria.nome : 'Sem categoria' %>
                                            </span>
                                        </td>
                                        <td>R$ <%= produto.preco.toFixed(2).replace('.', ',') %></td>
                                        <td>
                                            <% if (produto.disponivel) { %>
                                                <span class="badge bg-success">Disponível</span>
                                            <% } else { %>
                                                <span class="badge bg-danger">Indisponível</span>
                                            <% } %>
                                        </td>
                                        <td class="text-end">
                                            <a href="/admin/produtos/visualizar/<%= produto._id %>" class="btn btn-sm btn-outline-info">Ver</a>
                                            <a href="/admin/produtos/editar/<%= produto._id %>" class="btn btn-sm btn-outline-warning">Editar</a>
                                            <form action="/admin/produtos/excluir/<%= produto._id %>" method="POST" class="d-inline" onsubmit="return confirm('Tem certeza que deseja excluir este produto?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

<%- include('../../partials/footer') %>