<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Produto | Pé na Areia</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Pé na Areia</a>
            <span class="navbar-text text-white">Administração</span>
        </div>
    </nav>

    <main class="container py-4">
        <div class="mb-4">
            <h1 class="h3">Editar produto</h1>
            <p class="text-muted">Atualize as informações do produto</p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <form action="/admin/produtos/editar/<%= produto._id %>" method="POST">
                    <div class="mb-3">
                        <label for="nome" class="form-label">Nome do Produto</label>
                        <input type="text" class="form-control" id="nome" name="nome" value="<%= produto.nome %>" required>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="categoria" class="form-label">Categoria</label>
                            <select class="form-select" id="categoria" name="categoria" required>
                                <% categorias.forEach(cat => { %>
                                    <option value="<%= cat._id %>" <%= produto.categoria && produto.categoria.toString() === cat._id.toString() ? 'selected' : '' %>>
                                        <%= cat.nome %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="preco" class="form-label">Preço (R$)</label>
                            <input type="number" step="0.01" min="0" class="form-control" id="preco" name="preco" value="<%= produto.preco %>" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="descricao" class="form-label">Descrição</label>
                        <textarea class="form-control" id="descricao" name="descricao" rows="3"><%= produto.descricao %></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="imagem" class="form-label">URL da Imagem (opcional)</label>
                        <input type="text" class="form-control" id="imagem" name="imagem" value="<%= produto.imagem %>">
                    </div>

                    <div class="mb-4">
                        <label for="disponivel" class="form-label">Disponibilidade</label>
                        <select class="form-select" id="disponivel" name="disponivel">
                            <option value="true" <%= produto.disponivel ? 'selected' : '' %>>Disponível</option>
                            <option value="false" <%= !produto.disponivel ? 'selected' : '' %>>Indisponível</option>
                        </select>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                        <a href="/admin/produtos" class="btn btn-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </main>

</body>
</html>