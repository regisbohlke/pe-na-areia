
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categorias | Pé na Areia</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>
<body class="bg-light">

    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Pé na Areia</a>
            <span class="navbar-text text-white">
                Administração
            </span>
        </div>
    </nav>

   <main class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3">Categorias</h1>
            <p class="text-muted mb-0">
                Gerencie as categorias do cardápio.
            </p>
        </div>

        <a href="/admin/categorias/nova" class="btn btn-primary">
            Nova categoria
        </a>
    </div>

    <form action="/admin/categorias" method="GET" class="mb-3">
        <div class="input-group">
            <input
                type="text"
                name="busca"
                class="form-control"
                placeholder="Pesquisar categoria pelo nome..."
                value="<%= busca || '' %>"
            >

            <button type="submit" class="btn btn-primary">
                Pesquisar
            </button>

            <a href="/admin/categorias" class="btn btn-outline-secondary">
                Limpar
            </a>
        </div>
    </form>

        <% if (categorias.length === 0) { %>

            <div class="alert alert-info">
                Nenhuma categoria cadastrada.
            </div>

        <% } else { %>

            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">

                        <thead class="table-dark">
                            <tr>
                                <th>Nome</th>
                                <th>Descrição</th>
                                <th>Ordem</th>
                                <th>Status</th>
                                <th>Ações</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% categorias.forEach(categoria => { %>
                                <tr>
                                    <td><%= categoria.nome %></td>
                                    <td><%= categoria.descricao || '-' %></td>
                                    <td><%= categoria.ordemExibicao %></td>
                                    <td>
                                        <% if (categoria.ativo) { %>
                                            <span class="badge bg-success">Ativa</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary">Inativa</span>
                                        <% } %>
                                    </td>
                                    <td>
                                     <a
                                       href="/admin/categorias/editar/<%= categoria._id %>"
                                       class="btn btn-sm btn-outline-primary"
                                        >
                                            Editar
                                      </a>
                                    
                                        <form
    action="/admin/categorias/excluir/<%= categoria._id %>"
    method="POST"
    style="display: inline;"
    onsubmit="return confirm('Tem certeza que deseja excluir esta categoria?');"
>
    <button type="submit" class="btn btn-sm btn-outline-danger">
        Excluir
    </button>
</form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>

                    </table>
                </div>
            </div>

        <% } %>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
