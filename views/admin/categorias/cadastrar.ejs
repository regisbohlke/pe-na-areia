<%- include('../../partials/head', {
    tituloPagina: 'Nova Categoria | Pé na Areia'
}) %>

<%- include('../../partials/navbar', {
    paginaAtiva: 'categorias'
}) %>
    <main class="container py-4">

        <div class="mb-4">
            <h1 class="h3">Nova categoria</h1>
            <p class="text-muted">
                Preencha os dados para cadastrar uma categoria no cardápio.
            </p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">

                <form action="/admin/categorias" method="POST">

                    <div class="mb-3">
                        <label for="nome" class="form-label">
                            Nome da categoria *
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            id="nome"
                            name="nome"
                            placeholder="Ex.: Bebidas"
                            required
                        >
                    </div>

                    <div class="mb-3">
                        <label for="descricao" class="form-label">
                            Descrição
                        </label>

                        <textarea
                            class="form-control"
                            id="descricao"
                            name="descricao"
                            rows="3"
                            placeholder="Descreva a categoria..."
                        ></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="ordemExibicao" class="form-label">
                            Ordem de exibição
                        </label>

                        <input
                            type="number"
                            class="form-control"
                            id="ordemExibicao"
                            name="ordemExibicao"
                            value="0"
                            min="0"
                        >
                        <div class="form-text">
                            Menores números aparecem primeiro.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="ativo" class="form-label">
                            Situação
                        </label>

                        <select
                            class="form-select"
                            id="ativo"
                            name="ativo"
                        >
                            <option value="true" selected>Ativa</option>
                            <option value="false">Inativa</option>
                        </select>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            Salvar categoria
                        </button>

                        <a
                            href="/admin/categorias"
                            class="btn btn-outline-secondary"
                        >
                            Cancelar
                        </a>
                    </div>

                </form>

            </div>
        </div>

    </main>

   <%- include('../../partials/footer') %>

