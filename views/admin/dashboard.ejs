
<%- include('../partials/head', {
    tituloPagina: 'Dashboard | Pé na Areia'
}) %>

<%- include('../partials/navbar', {
    paginaAtiva: 'dashboard'
}) %>

<main class="container py-4 flex-grow-1">

    <div class="mb-4">
        <h1 class="h3">Dashboard</h1>
        <p class="text-muted mb-0">
            Acompanhe os pedidos e os cadastros do cardápio.
        </p>
    </div>

    <% if (erro) { %>

        <div class="alert alert-danger" role="alert">
            Não foi possível carregar o Dashboard. Tente atualizar a página.
        </div>

    <% } else { %>

        <section class="row g-3 mb-4" aria-label="Resumo da operação">

            <% indicadores.forEach(indicador => { %>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">

                            <h2 class="h6 text-muted">
                                <%= indicador.titulo %>
                            </h2>

                            <p class="h3 fw-semibold mb-1">
                                <%= indicador.valor %>
                            </p>

                            <p class="small text-muted mb-0">
                                <%= indicador.detalhe %>
                            </p>

                        </div>
                    </div>
                </div>

            <% }); %>

        </section>

        <section aria-labelledby="pedidos-recentes">

            <h2 class="h5 mb-3" id="pedidos-recentes">
                Pedidos recentes
            </h2>

            <% if (pedidos.length === 0) { %>

                <p class="alert alert-info mb-0">
                    Nenhum pedido cadastrado.
                </p>

            <% } else { %>

                <div class="card shadow-sm">

                    <div class="table-responsive">

                        <table class="table table-striped table-hover align-middle mb-0">

                            <thead class="table-dark">
                                <tr>
                                    <th scope="col">Pedido</th>
                                    <th scope="col">Data e hora</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Pagamento</th>
                                    <th scope="col" class="text-end">Valor</th>
                                </tr>
                            </thead>

                            <tbody>

                                <% pedidos.forEach(pedido => { %>

                                    <tr>
                                        <th scope="row">
                                            <%= pedido.numero %>
                                        </th>

                                        <td>
                                            <%= formatar.data(pedido.dataPedido) %>
                                        </td>

                                        <td>
                                            <span class="badge <%= formatar.status(pedido.status) %>">
                                                <%= pedido.status %>
                                            </span>
                                        </td>

                                        <td>
                                            <%= pedido.statusPagamento %>
                                        </td>

                                        <td class="text-end">
                                            <%= formatar.moeda(pedido.valorTotal) %>
                                        </td>
                                    </tr>

                                <% }); %>

                            </tbody>

                        </table>

                    </div>
                </div>

            <% } %>

        </section>

    <% } %>

</main>

<%- include('../partials/footer') %>
